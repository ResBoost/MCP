{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "src/*"
      ],
      "server-only": [
        "tests/stubs/server-only.ts"
      ],
      "~/env": [
        "tests/stubs/env.ts"
      ],
      "~/lib/site": [
        "tests/stubs/site.ts"
      ],
      "~/server/urls": [
        "tests/stubs/urls.ts"
      ],
      "~/server/lonres/client": [
        "tests/stubs/client.ts"
      ],
      "~/server/lonres/service": [
        "tests/stubs/service.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "vitest.config.ts"
  ]
}
